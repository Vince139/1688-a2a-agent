# 1688 多智能体系统 - Agent Dockerfile

FROM python:3.11-slim

WORKDIR /app

# 安装系统依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 安装 Python 依赖
COPY requirements-agent.txt .
RUN pip install --no-cache-dir -r requirements-agent.txt

# 复制应用代码
COPY agents/ ./agents/
COPY shared/ ./shared/

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:${AGENT_PORT:-8001}/health || exit 1

# 环境变量
ENV PYTHONUNBUFFERED=1
ENV AGENT_NAME=${AGENT_NAME:-entry}
ENV AGENT_PORT=${AGENT_PORT:-8001}

EXPOSE ${AGENT_PORT:-8001}

# 启动命令（根据 AGENT_NAME 启动对应 Agent）
# 使用 shell 格式让 docker-compose 能动态替换 AGENT_NAME
CMD python -m agents.${AGENT_NAME}.agent
